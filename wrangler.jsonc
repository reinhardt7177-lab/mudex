{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudex", "main": "cloud/worker.mjs", "compatibility_date": "2026-11-09",
  "account_id": "adb1d3eb001bc64ba9681b8cbb3244bd",
  "workers_dev": true, "preview_urls": false,
  "assets": {"directory":"ui", "binding":"ASSETS", "run_worker_first":true},
  "containers": [{"class_name":"MudexContainer", "image":"registry.cloudflare.com/adb1d3eb001bc64ba9681b8cbb3244bd/mudex:cloud-v7", "instance_type":"standard-1", "max_instances":20, "rollout_active_grace_period":7200}],
  "durable_objects": {"bindings":[{"name":"CONTAINERS", "class_name":"MudexContainer"}]},
  "migrations": [{"tag":"v1", "new_sqlite_classes":["MudexContainer"]}],
  "r2_buckets": [{"binding":"FILES", "bucket_name":"mudex-files"}],
  "ratelimits": [{"name":"LOGIN_LIMIT", "namespace_id":"1001", "simple":{"limit":60, "period":60}}],
  "observability": {"enabled":true, "head_sampling_rate":0.1}
}
